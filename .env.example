# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

# Domain — leave as localhost for local `docker compose up`. Set to your
# real domain (e.g. jobping.duckdns.org) once deployed; see
# docs/DEPLOYMENT.md. Only matters for the nginx service.
DOMAIN=localhost

# Database
DB_USER=postgres
DB_PASSWORD=change_me
DB_CONNECTION=Host=db;Port=5432;Database=jobping;Username=postgres;Password=change_me

# JWT
JWT_SECRET=ChangeThisToARandomStringAtLeast32CharactersLong!

# Redis
REDIS_PASSWORD=change_me

# RabbitMQ
RABBITMQ_USER=jobping
RABBITMQ_PASSWORD=change_me

# SendGrid — leave blank to run without real email delivery (MailWorker's
# retry ladder will exercise itself against SendGrid's auth failure, which
# is a legitimate way to see it work without a real account).
SENDGRID_API_KEY=

# Adzuna (developer.adzuna.com) and JSearch/RapidAPI (rapidapi.com, search
# "JSearch") — both free. Leave blank to run without them; each client
# logs a warning and skips itself rather than failing the whole fetch run.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
