# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

# Database
DB_USER=postgres
DB_PASSWORD=change_me
DB_CONNECTION=Host=db;Port=5432;Database=jobping;Username=postgres;Password=change_me

# JWT
JWT_SECRET=ChangeThisToARandomStringAtLeast32CharactersLong!

# Redis
REDIS_PASSWORD=change_me

# RabbitMQ
RABBITMQ_USER=jobping
RABBITMQ_PASSWORD=change_me

# SendGrid — leave blank to run without real email delivery (MailWorker's
# retry ladder will exercise itself against SendGrid's auth failure, which
# is a legitimate way to see it work without a real account).
SENDGRID_API_KEY=
